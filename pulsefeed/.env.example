# PulseFeed environment — copy to .env and edit.
#
# Every variable is optional. The server boots with none of them set and
# degrades along the documented ladder (mock LLM, hand-tuned scorer,
# memory-only state, auth off). Preflight (`pulsefeed-preflight`) verifies
# whatever you *do* set actually works before you take traffic.

# ---------------------------------------------------------------- LLM provider
# Hosted primary. Any OpenAI-compatible endpoint works.
#PULSEFEED_LLM_API_KEY=sk-...
#PULSEFEED_LLM_BASE_URL=https://api.openai.com/v1
#PULSEFEED_LLM_MODEL=gpt-4o-mini

# Local fallback (e.g. vLLM on your GPU box) — used when the primary's
# circuit opens. See docs/deployment.md §7.
#PULSEFEED_LOCAL_LLM_BASE_URL=http://gpu-box:8001/v1
#PULSEFEED_LOCAL_LLM_API_KEY=
#PULSEFEED_LOCAL_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---------------------------------------------------------------- durability
# Postgres record of truth (events, annotations, summaries, entity memory).
# Unset = memory-only; a restart starts from empty.
#PULSEFEED_PG_DSN=postgresql://pulsefeed:CHANGE_ME@localhost:5432/pulsefeed

# Restore state from the sink at boot (default on when a DSN is set).
#PULSEFEED_RESTORE=1
# Tenants to restore, comma-separated (default: PULSEFEED_TENANT).
#PULSEFEED_RESTORE_TENANTS=default

# Redis Streams ingestion bus. When set, POST /v1/events publishes to the
# stream (202 = durably in Redis) and an in-process consumer ingests with
# at-least-once delivery. Unset = direct in-process ingestion.
#PULSEFEED_REDIS_URL=redis://localhost:6379/0
#PULSEFEED_STREAM=pulsefeed:events
# Consumer name within the group; defaults to hostname-pid.
#PULSEFEED_CONSUMER=

# ---------------------------------------------------------------- scoring
# Fitted scorer from a training run (harness.train). Unset = hand-tuned
# weights. A bad file falls back silently — check /readyz after deploying.
#PULSEFEED_SCORER_MODEL=/etc/pulsefeed/scorer.json

# ---------------------------------------------------------------- budgets
#PULSEFEED_TENANT=default
#PULSEFEED_TOKEN_BUDGET=500000
#PULSEFEED_USD_BUDGET=5.0
#PULSEFEED_WORKERS=4
#PULSEFEED_AUDIT_RATE=0.01

# ---------------------------------------------------------------- security
# key:tenant pairs, comma separated; key:* = operator key. UNSET = AUTH OFF
# (dev mode). Anything internet-facing must set this.
#PULSEFEED_API_KEYS=acme-key-CHANGE_ME:acme,ops-key-CHANGE_ME:*
#PULSEFEED_RATE_WRITE_PER_SECOND=200
#PULSEFEED_RATE_READ_PER_SECOND=50
