# Application
NODE_ENV=development
PORT=3000
API_VERSION=v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017/timeline_feed
MONGODB_MAX_POOL_SIZE=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=timeline-feed-service
KAFKA_GROUP_ID=timeline-feed-group

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Cache
CACHE_TTL=1800
TIMELINE_CACHE_SIZE=1000
HOT_CONTENT_THRESHOLD=1000

# Fanout
FANOUT_CELEBRITY_THRESHOLD=10000
FANOUT_BATCH_SIZE=1000

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info
